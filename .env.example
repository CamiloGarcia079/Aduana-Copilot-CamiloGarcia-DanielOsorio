# ---- Modelo del reto ----
# La llave la da el panel del reto. Nunca se sube al repositorio.
AGENT_API_KEY=
RETO_BASE_URL=https://api.reto.pltk.mx/v1
RETO_MODEL=grok-4.6

# Precio del modelo, en dolares por millon de tokens. Sale del panel.
# Si quedan en cero, el agente corre pero no reporta costo.
AGENT_PRICE_IN_USD=0
AGENT_PRICE_OUT_USD=0

# Tope de vueltas del ciclo del agente.
AGENT_MAX_STEPS=4

# Pon true para probar el ciclo completo sin gastar credito del reto.
AGENT_FAKE_LLM=false

# ---- Servicios propios ----
# Gateway de Node. Lo consumen el agente y la interfaz.
PORT=3000
GATEWAY_URL=http://127.0.0.1:3000

# Motor de calculo en Python.
CORE_URL=http://127.0.0.1:5000
CORE_TIMEOUT_MS=15000
